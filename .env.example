# Database URL (SQLite for local zero-cost, or PostgreSQL connection string)
DATABASE_URL=sqlite:///./transformo_docs.db

# Storage Directory
UPLOAD_DIR=./storage

# Google Gemini API Key (Get a FREE key from https://aistudio.google.com)
GEMINI_API_KEY=

# Telegram Bot Token (Get a FREE token from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# Internal API Base URL (For Telegram Bot communication)
API_BASE_URL=http://localhost:8000/api/v1
